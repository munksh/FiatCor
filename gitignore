# Qt Creator's per-user project state. Absolute paths, kit ids and the
# device it last deployed to — never committed, and the single most common
# thing to accidentally push from a Qt project.
*.pro.user
*.pro.user.*

# qmake output. Qt Creator builds out of source, in a sibling directory
# (~/Projects/build-FiatCor-...), so these normally never appear here —
# but they do the moment anyone runs qmake in the source tree.
Makefile
Makefile.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.o
*.so
build/
build-*/
.qmake.stash

# RPM output
RPMS/
*.rpm
*.tar.bz2

# Generated by tools/make_preview.py — reproducible, so not in the repo.
fiat-cor-preview.html

# Python
__pycache__/
*.pyc

# Editors and desktops
*~
.DS_Store
.idea/
.vscode/
