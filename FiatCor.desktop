[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=FiatCor
Exec=FiatCor
Name=Fiat Cor
Comment=Metronome

# Sailjail stays commented out while sideloading — an unsandboxed app gets
# audio and vibration without declaring anything, which is what you want in
# development. Before submitting to Chum or the Jolla Store, uncomment the
# block below and change Exec to:
#   Exec=sailjail -p FiatCor.desktop /usr/bin/FiatCor
#
# [X-Sailjail]
# OrganizationName=se.munkstolen
# ApplicationName=FiatCor
# Permissions=Audio
